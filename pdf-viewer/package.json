{
  "name": "volt-pdf-reader",
  "productName": "Volt",
  "version": "1.0.1",
  "description": "Fast, private, ad-free PDF reader/editor with AI built in — powered by your local LLM.",
  "author": "Volt",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "smoke:browser": "electron . --smoke-browser",
    "smoke:browser:headless": "electron . --smoke-browser --smoke-no-focus",
    "update:vendor": "node scripts/update-vendor.mjs",
    "check:vendor": "node scripts/update-vendor.mjs --check",
    "test:watch": "node scripts/test-file-watcher.mjs",
    "test:utils": "node scripts/test-utils.mjs",
    "test:sign": "node scripts/test-sign.mjs",
    "test:office": "node scripts/test-office.mjs",
    "test:artifacts": "node scripts/test-artifact-regression.mjs",
    "test:release-feed": "node scripts/test-release-feed.mjs",
    "check:launchers": "node ../scripts/check-launchers.cjs",
    "gen:sw": "node scripts/gen-sw.mjs --write",
    "check:sw": "node scripts/gen-sw.mjs --check",
    "auto:vendor": "node scripts/auto-update.cjs --smoke-exe \"node_modules/electron/dist/electron.exe\"",
    "dist": "node scripts/run-builder.cjs --win nsis",
    "dist:dir": "node scripts/run-builder.cjs --win dir",
    "release": "node scripts/release.cjs",
    "sign:check": "node scripts/check-signing.cjs",
    "sign:setup": "node scripts/signing-setup.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.volt.pdfreader",
    "productName": "Volt",
    "asar": true,
    "asarUnpack": [
      "vendor/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "vendor/**/*",
      "assets/**/*",
      "samples/**/*",
      "scripts/**/*",
      "sw.js",
      "manifest.json",
      "package.json",
      "CHANGELOG.md",
      "VERSION"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/volt.ico",
      "artifactName": "Volt-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Volt",
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Volt PDF",
        "description": "PDF Document",
        "icon": "assets/volt.ico",
        "role": "Viewer"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cyborgpulsedev",
        "repo": "volt",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    }
  }
}
